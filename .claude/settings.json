{
  "permissions": {
    "allow": [
      "Bash(python3 -m unittest:*)",
      "Bash(python3 app/todo.py:*)",
      "Bash(python3 .claude/skills/add-command/scripts/smoke_test.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\""
          }
        ]
      }
    ]
  }
}
